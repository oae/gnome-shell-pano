{
  "name": "pano",
  "version": "1.0.0",
  "author": "Alperen Elhan <alperen@elhan.io>",
  "private": true,
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "pnpm run build:ts && pnpm run gen:locale && pnpm run build:extension",
    "gen:locale": "NODE_OPTIONS='--experimental-require-module' pnpm exec ts-node scripts/generateLocale.ts",
    "check:locale": "NODE_OPTIONS='--experimental-require-module' pnpm exec ts-node scripts/generateLocale.ts --dry-run",
    "build:ts": "pnpm run clean:ts && rollup -c --failAfterWarnings && sed -i '/setTimeout/d' dist/thirdparty/prismjs.js && sed -i 's/var\\ /let\\ /g' dist/extension.js dist/prefs.js",
    "clean:ts": "rm -rf ./dist",
    "build:extension": "pnpm run build:schema",
    "build:schema": "pnpm run clean:schema && glib-compile-schemas ./resources/schemas --targetdir=./dist/schemas/",
    "clean:schema": "rm -rf ./dist/schemas/*.compiled",
    "build:package": "pnpm run build && rm -rf './dist/pano@elhan.io.zip' && cd ./dist && zip -qr 'pano@elhan.io.zip' .",
    "watch": "pnpm run build && pnpm run rollup -c --watch",
    "test": "jasmine --module --no-config build/tests/",
    "lint": "eslint src/",
    "shell:restart": "busctl --user call org.gnome.Shell /io/elhan/Pano io.elhan.Pano restart",
    "build-and-restart": "pnpm run build && pnpm run shell:restart",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write ."
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "pnpm run lint",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "engines": {
    "node": ">= 20.17.0 || >= 22.0.0 || >= 24.0.0"
  },
  "engineStrict": true,
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@girs/adw-1": "1.10.0-4.0.0-rc.9",
    "@girs/clutter-18": "18.0.0-4.0.0-rc.9",
    "@girs/cogl-18": "18.0.0-4.0.0-rc.9",
    "@girs/gda-5.0": "5.0.0-4.0.0-rc.9",
    "@girs/gda-6.0": "6.0.0-4.0.0-rc.9",
    "@girs/gdk-4.0": "4.0.0-4.0.0-rc.9",
    "@girs/gdkpixbuf-2.0": "2.0.0-4.0.0-rc.9",
    "@girs/gio-2.0": "2.88.0-4.0.0-rc.9",
    "@girs/glib-2.0": "2.88.0-4.0.0-rc.9",
    "@girs/gnome-shell": "50.0.0",
    "@girs/gobject-2.0": "2.88.0-4.0.0-rc.9",
    "@girs/graphene-1.0": "1.0.0-4.0.0-rc.9",
    "@girs/gsound-1.0": "1.0.0-4.0.0-rc.9",
    "@girs/gtk-4.0": "4.23.0-4.0.0-rc.9",
    "@girs/meta-18": "18.0.0-4.0.0-rc.9",
    "@girs/pango-1.0": "1.57.1-4.0.0-rc.9",
    "@girs/shell-18": "18.0.0-4.0.0-rc.9",
    "@girs/soup-3.0": "3.6.6-4.0.0-rc.9",
    "@girs/st-18": "18.0.0-4.0.0-rc.9",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tsconfig/strictest": "^2.0.8",
    "@types/eslint": "^9.6.1",
    "@types/events": "^3.0.3",
    "@types/gettext-parser": "^9.0.0",
    "@types/is-url": "^1.2.32",
    "@types/jasmine": "^7.0.0",
    "@types/node": "^26.6.5",
    "@types/prismjs": "^1.26.6",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "chalk": "4.1.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "fill-pot-po": "^4.0.2",
    "gettext-extractor": "^4.0.6",
    "gettext-parser": "^9.1.1",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "rollup": "^4.64.12",
    "rollup-plugin-cleanup": "^3.2.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-styler": "^3.0.1",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "date-fns": "^2.30.0",
    "hex-color-converter": "^0.2.1",
    "highlight.js": "^11.12.0",
    "htmlparser2": "^12.0.0",
    "is-url": "^1.2.4",
    "pretty-bytes": "^7.2.0",
    "prismjs": "^1.30.0",
    "validate-color": "^2.2.4"
  },
  "packageManager": "pnpm@12.14.0",
  "pnpm": {}
}
